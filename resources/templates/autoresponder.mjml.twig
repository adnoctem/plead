{# Renders MJML markup for ONE language - convert it with spatie/mjml (or
   mjml.io) before handing it to Plesk. The language comes from the
   'language' context variable (--language / template.language / the first
   catalog language); the txt template renders every language instead.
   Sentences come from resources/translations/autoresponder.{locale}.yaml, per-language
   data values resolve as key[lang] ?? key.de ?? key, and the logo comes from
   template.logo_url (overridable per campaign via a data-file logo_url). #}
{% set lang = language ?? languages|first %}
{% set fmt = 'date_format'|trans({}, 'autoresponder', lang) %}
{% set phone = phonenumber[lang] ?? phonenumber.de ?? phonenumber %}
{% set email = email[lang] ?? email.de ?? email %}
{% set vars = {
    '%start%': '<span style="font-weight:600">' ~ startDate|date(fmt) ~ '</span>',
    '%end%': '<span style="font-weight:600">' ~ endDate|date(fmt) ~ '</span>',
    '%phone%': '<a href="tel:' ~ phone ~ '" style="text-decoration:none;color:#F39200">' ~ phone ~ '</a>',
    '%department%': department[lang] ?? department.de ?? department,
    '%email%': '<a href="mailto:' ~ email ~ '" style="text-decoration:none;color:#F39200">' ~ email ~ '</a>',
    '%firstname%': firstname,
    '%surname%': surname,
} %}
<mjml background-color="#0B0B0F">
    <mj-head>
        <mj-font name="Source Sans 3" href="https://fonts.googleapis.com/css?family=Source+Sans+3"></mj-font>
        <mj-attributes>
            <mj-all font-family="'Source Sans 3', Helvetica, Arial, sans-serif" color="#F5F5F5"></mj-all>
            <mj-text font-weight="400" font-size="18px" line-height="28px" align="center" padding="0px"></mj-text>
        </mj-attributes>
        <mj-style>
            .aa-card { background-color: #1A1A1F; border-radius: 24px; box-shadow: 0 0 65px rgba(243, 146, 0, 0.55); }
            .aa-btn td { border-radius: 14px !important; box-shadow: 0 0 40px rgba(243, 146, 0, 0.5); }
            .aa-btn a { color: #0B0B0F !important; }
            .aa-btn:hover td { background: #FFA31A !important; }
            .aa-btn:hover a { background: #FFA31A !important; }

            /* Mobile: shrink the page gaps and tighten the card so the
               desktop "stretched" look stays usable on small screens. */
            @media only screen and (max-width:650px) {
                .aa-gap td, .aa-gap div { height: 56px !important; line-height: 56px !important; }
                .aa-card { padding: 20px 16px !important; border-radius: 16px !important; }
            }
        </mj-style>
    </mj-head>
    <mj-body background-color="#0B0B0F" width="650px">
        <mj-section background-color="transparent" padding="24px 0px 0px 0px">
            <mj-column>
                <mj-image padding="0px" width="120px" src="{{ logo_url ?? 'https://github.com/adnoctem/artwork/blob/38866111fd02fab46ce80117372240815d7dbf27/projects/plead/white/plead-icon-white.png?raw=true' }}" alt="plead"></mj-image>
            </mj-column>
        </mj-section>
        <mj-section background-color="transparent" padding="0px">
            <mj-column>
                <mj-spacer css-class="aa-gap" height="196px"></mj-spacer>
            </mj-column>
        </mj-section>
        <mj-section background-color="transparent" padding="16px 0px 16px 0px">
            <mj-column css-class="aa-card" padding="30px 40px" vertical-align="top">
                <mj-text font-size="20px" font-weight="600">{{ 'greeting'|trans(vars, 'autoresponder', lang) }}</mj-text>
                <mj-spacer height="24px"></mj-spacer>
                <mj-text>{% if inclusive -%}{{ 'period_inclusive'|trans(vars, 'autoresponder', lang) }}{%- else -%}{{ 'period_until'|trans(vars, 'autoresponder', lang) }}{%- endif %}</mj-text>
                <mj-spacer height="24px"></mj-spacer>
                <mj-text>{{ 'forwarded'|trans(vars, 'autoresponder', lang) }}</mj-text>
                <mj-spacer height="24px"></mj-spacer>
                <mj-text>{{ 'regards'|trans(vars, 'autoresponder', lang) }}</mj-text>
                <mj-text font-weight="600">{{ firstname }} {{ surname }}</mj-text>
            </mj-column>
        </mj-section>
        <mj-section background-color="transparent" padding="8px 0px 16px 0px">
            <mj-column width="42%" vertical-align="middle">
                <mj-button href="tel:{{ phone }}" padding="0px" border-radius="14px" background-color="#F39200" font-size="18px" font-weight="600" width="100%" css-class="aa-btn">{{ 'phone_button'|trans(vars, 'autoresponder', lang) }}</mj-button>
            </mj-column>
            <mj-column width="4%" padding="10px"></mj-column>
            <mj-column width="42%">
                <mj-button href="mailto:{{ email }}" padding="0px" border-radius="14px" background-color="#F39200" font-size="18px" font-weight="600" width="100%" css-class="aa-btn">{{ 'email_button'|trans(vars, 'autoresponder', lang) }}</mj-button>
            </mj-column>
        </mj-section>
        <mj-section background-color="transparent" padding="0px">
            <mj-column>
                <mj-spacer css-class="aa-gap" height="196px"></mj-spacer>
            </mj-column>
        </mj-section>
        <mj-section text-align="center">
            <mj-column vertical-align="bottom" padding="20px 20px 0px 0px">
                <mj-social mode="horizontal" icon-size="24px" padding="0px" inner-padding="0px 10px 0px 0px" align="left">
                    <mj-social-element name="github" href="https://github.com/adnoctem" background-color="transparent"></mj-social-element>
                    <mj-social-element name="x" href="https://github.com/adnoctemcollective" background-color="transparent"></mj-social-element>
                    <mj-social-element name="web" href="https://adnoctem.co" background-color="transparent"></mj-social-element>
                </mj-social>
                <mj-spacer height="14px"></mj-spacer>
                <mj-text align="left" padding="0px" font-size="14px" line-height="22px" color="#fff">© 2026 - Ad Noctem Collective</mj-text>
                <mj-spacer height="14px"></mj-spacer>
            </mj-column>
        </mj-section>
    </mj-body>
</mjml>
