{# Renders MJML markup - convert it with spatie/mjml (or mjml.io) before
   handing it to Plesk. Same catalogs and data conventions as the txt
   template: sentences come from translations/autoresponder.{locale}.yaml,
   per-language data values resolve as key[lang] ?? key, and the logo comes
   from template.logo_url (overridable per campaign via a data-file
   logo_url). #}
<mjml>
    <mj-head>
        <mj-font name="Source Sans 3" href="https://fonts.googleapis.com/css?family=Source+Sans+3"></mj-font>
        <mj-attributes>
            <mj-all font-family="'Source Sans 3', Helvetica, Arial, sans-serif" color="#F5F5F5"></mj-all>
            <mj-text font-weight="400" font-size="18px" line-height="28px" align="center" padding="0px"></mj-text>
        </mj-attributes>
        <mj-style>
            .aa-card { background-color: #1A1A1F; border-radius: 24px; box-shadow: 0 0 60px rgba(243, 146, 0, 0.35); }
            .aa-btn td { border-radius: 14px !important; box-shadow: 0 0 24px rgba(243, 146, 0, 0.35); }
            .aa-btn a { color: #0B0B0F !important; }
            .aa-btn:hover td { background: #FFA31A !important; }
        </mj-style>
    </mj-head>
    <mj-body background-color="#0B0B0F">
        <mj-section background-color="transparent" padding="24px 0px 0px 0px">
            <mj-column>
                <mj-image padding="0px" width="120px" src="{{ logo_url ?? 'https://github.com/adnoctem/artwork/blob/38866111fd02fab46ce80117372240815d7dbf27/projects/plead/white/plead-icon-white.png?raw=true' }}" alt="plead"></mj-image>
            </mj-column>
        </mj-section>
        {% for lang in languages %}
        {% set fmt = 'date_format'|trans({}, 'autoresponder', lang) %}
        {% set vars = {
            '%start%': startDate|date(fmt),
            '%end%': endDate|date(fmt),
            '%phone%': phonenumber[lang] ?? phonenumber.de ?? phonenumber,
            '%department%': department[lang] ?? department.de ?? department,
            '%email%': email[lang] ?? email.de ?? email,
            '%firstname%': firstname,
            '%surname%': surname,
        } %}
        <mj-section background-color="transparent" padding="16px 0px 16px 0px">
            <mj-column css-class="aa-card" padding="30px 40px">
                <mj-text font-size="20px" font-weight="600">{{ 'greeting'|trans(vars, 'autoresponder', lang) }}</mj-text>
                <mj-spacer height="24px"></mj-spacer>
                {% if inclusive -%}
                <mj-text>{{ 'period_inclusive'|trans(vars, 'autoresponder', lang) }}</mj-text>
                {%- else -%}
                <mj-text>{{ 'period_until'|trans(vars, 'autoresponder', lang) }}</mj-text>
                {%- endif %}
                <mj-spacer height="16px"></mj-spacer>
                <mj-text>{{ 'forwarded'|trans(vars, 'autoresponder', lang) }}</mj-text>
                <mj-spacer height="24px"></mj-spacer>
                <mj-text>{{ 'regards'|trans(vars, 'autoresponder', lang) }}</mj-text>
                <mj-text font-weight="600">{{ firstname }} {{ surname }}</mj-text>
                <mj-spacer height="28px"></mj-spacer>
                <mj-button href="tel:{{ phonenumber[lang] ?? phonenumber.de ?? phonenumber }}" padding="0px 8px 16px 8px" border-radius="14px" background-color="#F39200" font-size="18px" font-weight="600" width="100%" css-class="aa-btn">{{ 'phone_button'|trans(vars, 'autoresponder', lang) }}</mj-button>
                <mj-button href="mailto:{{ email[lang] ?? email.de ?? email }}" padding="0px 8px 0px 8px" border-radius="14px" background-color="#F39200" font-size="18px" font-weight="600" width="100%" css-class="aa-btn">{{ 'email_button'|trans(vars, 'autoresponder', lang) }}</mj-button>
            </mj-column>
        </mj-section>
        {% if not loop.last %}<mj-spacer height="16px"></mj-spacer>{% endif %}
        {% endfor %}
    </mj-body>
</mjml>
