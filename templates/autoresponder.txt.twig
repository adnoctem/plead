{# All sentences come from translations/autoresponder.{locale}.yaml; this
   template only holds structure. It loops over the languages found in the
   catalog directory; 'de' is the fallback locale for missing entries.
   Data values that differ per language use locale maps resolved as
   key[lang] ?? key.de ?? key (e.g. email: {de: ..., en: ...}); a missing
   locale falls back to the German value, scalars to themselves.
   Note: Twig consumes one newline after every {% tag %} - keep two blank
   source lines where the message should show a blank line. #}
{% for lang in languages %}
{% set fmt = 'date_format'|trans({}, 'autoresponder', lang) %}
{% set vars = {
    '%start%': startDate|date(fmt),
    '%end%': endDate|date(fmt),
    '%phone%': phonenumber[lang] ?? phonenumber.de ?? phonenumber,
    '%department%': department[lang] ?? department.de ?? department,
    '%email%': email[lang] ?? email.de ?? email,
    '%firstname%': firstname,
    '%surname%': surname,
} %}
{{ 'greeting'|trans(vars, 'autoresponder', lang) }}

{% if inclusive -%}{{ 'period_inclusive'|trans(vars, 'autoresponder', lang) }}{%- else -%}{{ 'period_until'|trans(vars, 'autoresponder', lang) }}{%- endif %}

{{ 'forwarded'|trans(vars, 'autoresponder', lang) }}

{{ 'regards'|trans(vars, 'autoresponder', lang) }}

{{ firstname }} {{ surname }}

{% if not loop.last %}---{% endif %}


{% endfor %}
