{
    "name": "adnoctem/plead",
    "description": "A command-line application to manage Plesk mail servers over XML-RPC or HTTP REST with numerous feature enhancements",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-pdo_sqlite": "*",
        "ext-simplexml": "*",
        "monolog/monolog": "^3.10",
        "phpseclib/phpseclib": "^3.0",
        "plesk/api-php-lib": "^2.2",
        "symfony/config": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/filesystem": "8.1.*",
        "symfony/yaml": "8.1.*",
        "twig/twig": "^3.28"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5.56"
    },
    "scripts": {
        "tests": [
            "@tests:phpunit"
        ],
        "lint": [
            "@lint:phpstan",
            "@lint:php-cs-fixer"
        ],
        "build": [
            "@build:docker"
        ],
        "tests:phpunit": "vendor/bin/phpunit",
        "lint:phpstan": "vendor/bin/phpstan analyse",
        "lint:php-cs-fixer": "vendor/bin/php-cs-fixer fix --diff",
        "build:docker": "docker buildx bake -f docker/docker-bake.hcl"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "conflict": {
        "symfony/symfony": "*"
    }
}
