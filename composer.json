{
  "name": "adnoctem/plead",
  "description": "A command-line application to manage Plesk mail servers over XML-RPC or HTTP REST with numerous feature enhancements",
  "type": "project",
  "license": "MIT",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": ">=8.4.27",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "ext-pdo_sqlite": "*",
    "ext-simplexml": "*",
    "monolog/monolog": "^3.12.1",
    "phpseclib/phpseclib": "^3.0.58",
    "plesk/api-php-lib": "^2.2",
    "spatie/mjml-php": "^1.3",
    "symfony/config": "8.1.*",
    "symfony/console": "8.1.*",
    "symfony/dotenv": "8.1.*",
    "symfony/filesystem": "8.1.*",
    "symfony/translation": "8.1.*",
    "symfony/twig-bridge": "8.1.*",
    "symfony/yaml": "8.1.*",
    "twig/twig": "^3.30"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95.27",
    "phpstan/phpstan": "^2.3.4",
    "phpunit/phpunit": "^11.5.57"
  },
  "scripts": {
    "tests": [
      "@tests:phpunit"
    ],
    "lint": [
      "@lint:phpstan",
      "@lint:php-cs-fixer"
    ],
    "image": [
      "@build:image"
    ],
    "build": [
      "@build:images",
      "@build:phar",
      "@build:checksums"
    ],
    "tests:phpunit": "vendor/bin/phpunit",
    "lint:phpstan": "vendor/bin/phpstan analyze",
    "lint:php-cs-fixer": "vendor/bin/php-cs-fixer fix --dry-run --diff",
    "build:image": "docker buildx build -t adnoctem/plead:latest -f docker/Dockerfile .",
    "build:images": "docker buildx bake -f docker/docker-bake.hcl",
    "build:phar": "box compile",
    "build:checksums": "sha256sum dist/* > dist/CHECKSUMS_SHA256.txt"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    },
    "bump-after-update": true,
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "replace": {
    "symfony/polyfill-ctype": "*",
    "symfony/polyfill-iconv": "*",
    "symfony/polyfill-php72": "*",
    "symfony/polyfill-php73": "*",
    "symfony/polyfill-php74": "*",
    "symfony/polyfill-php80": "*",
    "symfony/polyfill-php81": "*",
    "symfony/polyfill-php82": "*",
    "symfony/polyfill-php83": "*",
    "symfony/polyfill-php84": "*"
  },
  "conflict": {
    "symfony/symfony": "*"
  }
}
